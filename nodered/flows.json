  {
    "id": "chart-transform",
    "type": "function",
    "z": "irrigation-flow",
    "name": "Format chart",
    "func": "if (msg.payload == null || msg.payload.soil_moisture == null) return null;\nconst value = Number(msg.payload.soil_moisture); return Number.isFinite(value) && value >= 0 && value <= 100 ? {payload: value, topic: 'soil_moisture', timestamp: Date.now()} : null;",
    "outputs": 1,
    "x": 210,
