  {
    "id": "manual-pump-request",
    "type": "function",
    "z": "irrigation-flow",
    "name": "Prepare manual CoAP command",
    "func": "const action = typeof msg.payload === 'string' && msg.payload.includes('on') ? 'on' : 'off'; msg.headers={'content-type':'application/json'}; msg.payload={action,mode:'manual',requested_at:new Date().toISOString()}; msg.url='http://coap-gateway:8081/pump'; return msg;",
    "outputs": 1,
    "x": 470,
    "y": 410,
    "wires": [["coap-gateway"]]
  },
