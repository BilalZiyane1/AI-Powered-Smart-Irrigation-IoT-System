  },
  {
    "id": "gauge-transform",
    "type": "function",
    "z": "irrigation-flow",
    "name": "Format gauge",
    "func": "if (msg.payload == null || msg.payload.soil_moisture == null) return null;\nconst value = Number(msg.payload.soil_moisture); return Number.isFinite(value) && value >= 0 && value <= 100 ? {payload: value} : null;",
    "outputs": 1,
    "x": 210,
    "y": 300,
    "wires": [["soil-gauge"]]
  },
  {
