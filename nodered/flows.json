[
  {
    "id": "irrigation-flow",
    "type": "tab",
    "label": "Smart irrigation",
    "disabled": false,
    "info": "Validated MQTT ingestion foundation"
  },
  {
    "id": "soil-ingestion",
    "type": "mqtt in",
    "z": "irrigation-flow",
    "name": "Soil moisture",
    "topic": "ferme/parcelle1/humidite_sol",
    "qos": "1",
    "datatype": "json",
    "broker": "local-mosquitto",
    "x": 150,
    "y": 100,
    "wires": [["store-soil", "irrigation-decision"]]
  },
  {
    "id": "store-soil",
    "type": "function",
    "z": "irrigation-flow",
    "name": "Validate and retain",
    "func": "if (msg.payload == null || msg.payload.soil_moisture == null) return null;\nconst value = Number(msg.payload.soil_moisture);\nif (!Number.isFinite(value) || value < 0 || value > 100) { return null; }\nflow.set('latestMoisture', msg.payload);\nmsg.measurement = 'soil_moisture';\nmsg.payload = [{ soil_moisture: value }, { device: msg.payload.device_id || 'unknown', sector: String(msg.payload.sector || 1) }];\nreturn msg;",
    "outputs": 1,
    "x": 390,
    "y": 100,
    "wires": [["debug-ingestion", "influx-line"]]
  },
  {
    "id": "debug-ingestion",
    "type": "debug",
    "z": "irrigation-flow",
    "name": "Validated soil data",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "x": 650,
    "y": 100,
    "wires": []
  },
  {
    "id": "influx-line",
    "type": "function",
    "z": "irrigation-flow",
    "name": "Build Influx line",
    "func": "const fields = msg.payload[0] || {};\nconst tags = msg.payload[1] || {};\nconst value = Number(fields.soil_moisture);\nif (!Number.isFinite(value) || value < 0 || value > 100) return null;\nconst device = String(tags.device || 'unknown').replace(/[, =]/g, '_');\nmsg.url = 'http://influxdb:8086/api/v2/write?org=smart-irrigation&bucket=telemetry&precision=ms';\nmsg.headers = { 'Content-Type': 'text/plain', 'Authorization': 'Token irrigation-local-token' };\nmsg.payload = `soil_moisture,device=${device},sector=${tags.sector || '1'} value=${value} ${Date.now()}`;\nreturn msg;",
    "outputs": 1,
    "x": 680,
    "y": 120,
    "wires": [["influx-http"]]
  },
  {
    "id": "influx-http",
    "type": "http request",
    "z": "irrigation-flow",
    "name": "Write InfluxDB",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "",
    "persist": false,
    "authType": "",
    "senderr": true,
    "headers": [],
    "x": 900,
    "y": 120,
    "wires": [["influx-result"]]
  },
  {
    "id": "influx-result",
    "type": "debug",
    "z": "irrigation-flow",
    "name": "InfluxDB result",
    "active": true,
    "tosidebar": true,
    "complete": "true",
    "targetType": "full",
    "x": 1100,
    "y": 120,
    "wires": []
  },
  {
    "id": "irrigation-decision",
    "type": "function",
    "z": "irrigation-flow",
    "name": "Safe irrigation decision",
    "func": "if (msg.payload == null || msg.payload.soil_moisture == null) return null;\nconst moisture = Number(msg.payload.soil_moisture);\nif (!Number.isFinite(moisture) || moisture < 0 || moisture > 100) return null;\nconst low = Number(flow.get('lowThreshold') ?? 40);\nconst high = Number(flow.get('highThreshold') ?? 60);\nconst current = flow.get('desiredPumpState') || 'off';\nlet desired = current;\nif (current === 'off' && moisture < low) desired = 'on';\nif (current === 'on' && moisture >= high) desired = 'off';\nif (desired === current) return null;\nflow.set('desiredPumpState', desired);\nmsg.headers = { 'content-type': 'application/json' };\nmsg.payload = { action: desired, mode: flow.get('operatingMode') || 'rule_based', requested_at: new Date().toISOString() };\nmsg.url = 'http://coap-gateway:8081/pump';\nreturn msg;",
    "outputs": 1,
    "x": 400,
    "y": 180,
    "wires": [["coap-gateway"]]
  },
  {
    "id": "coap-gateway",
    "type": "http request",
    "z": "irrigation-flow",
    "name": "Command through CoAP gateway",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "persist": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 680,
    "y": 180,
    "wires": [["command-result"]]
  },
  {
    "id": "command-result",
    "type": "debug",
    "z": "irrigation-flow",
    "name": "Pump command result",
    "active": true,
    "tosidebar": true,
    "complete": "true",
    "targetType": "full",
    "x": 930,
    "y": 180,
    "wires": []
  },
